# Ngăn chặn việc thực thi PHP
<FilesMatch "\.(php|php5|phtml|phps|phar)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Chỉ cho phép tải xuống các tệp thông thường như hình ảnh, tài liệu
<FilesMatch "\.(jpg|jpeg|png|gif|pdf|doc|docx|xls|xlsx|zip|rar)$">
    Order allow,deny
    Allow from all
</FilesMatch>