APP_NAME="THT Media"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=truyenthongthtmedia
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@thtmedia.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Site Config ──────────────────────────────────
SITE_NAME="THT Media"
SITE_DESCRIPTION="Chuyên cung cấp dịch vụ truyền thông, quay phim, chụp ảnh chuyên nghiệp."
SITE_PHONE=
SITE_EMAIL=
SITE_ADDRESS=
SITE_FACEBOOK=
SITE_YOUTUBE=
SITE_ZALO=
SITE_INSTAGRAM=
SITE_OG_IMAGE=/images/og-default.jpg

VITE_APP_NAME="${APP_NAME}"
